### Skyline birth-death-sampling inference over dnBDS, with the record on a dnFossilRecord node.
###
### A copy of infer-fbdrp.Rev with the process swapped and nothing else changed: same
### priors, origin prior, moves and monitors, so the two arms differ only in the density.
###
### Every prior hyperparameter arrives as a variable set by the per-rep aux file that
### simfbdr writes from the batch's config.yml. Nothing is hardcoded here: the batch
### that generated the data and the analysis of it read one definition, so they
### cannot drift apart.
###
### Set before sourcing: rep, SKYLINE, COMPLETE, COND, RHO, COEXISTENCE, RANGE_START,
###   GENS, PRINTGEN,
###   OCCURRENCES, BATCHDIR, OUTDIR, the GAMMA_ settings, AGE_MIN, AGE_MAX,
###   ORIGIN_PRIOR, MAXFA

# TAXA is set when the run treats the occurrence ages some other way than as reported
if (!exists("TAXA")) TAXA <- BATCHDIR + "/" + OCCURRENCES + "/taxa_" + rep + ".tsv"
taxa <- readTaxonData(TAXA)

# PyRate's input is fossil occurrences, so a taxon seen only alive at the present is not in it.
# Dropping them keeps the rest exactly PyRate's likelihood under condition="sampling".
if (!exists("DROP_PRESENT_ONLY")) DROP_PRESENT_ONLY <- FALSE
if (!exists("PRESENT")) PRESENT <- 0
if (DROP_PRESENT_ONLY) {
    all_taxa <- taxa
    n_kept <- 0
    # a comparison retypes its operand to Real, and dnBDS takes present as RealPos, so compare a copy
    present_age <- PRESENT
    for (i in 1:all_taxa.size()) {
        if (all_taxa[i].getMaxAge() > present_age) {
            n_kept <- n_kept + 1
            kept[n_kept] <- all_taxa[i]
        }
    }
    taxa <- kept
}

moves = VectorMoves()

# the rate prior and its guards live in one place, so the arms cannot drift
source(BINDIR + "/rates-prior.Rev")



# uniform is the simulator's own age draw, U(AGE_MIN, AGE_MAX). exponential is PyRate's:
# rate and lower truncation both the oldest observed first appearance, no upper bound.
# Truncating an exponential below at m and shifting it to m are the same thing, so the
# offset argument gives PyRate's prior exactly.
# "none" supplies no origin, leaving the oldest birth as the process start under an improper
# flat prior, which is the parameterization before the origin node existed.
if (ORIGIN_PRIOR != "none") {
    if (ORIGIN_PRIOR == "exponential") {
        origin ~ dnExponential(1/MAXFA, offset=MAXFA)
    } else {
        origin ~ dnUniform(AGE_MIN, AGE_MAX)
    }
    # The oldest birth is welded to this node, so the record's oldest occurrence bounds it from
    # below. AGE_MAX is above every occurrence, so starting there is always feasible.
    origin.setValue(AGE_MAX)
    moves.append( mvSlide(origin, delta=0.5, weight=2) )
    moves.append( mvSlide(origin, delta=2.0, weight=2) )
}

if (ORIGIN_PRIOR == "none") {
    if (SKYLINE) {
        bd ~ dnBDS(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=RHO, present=PRESENT,
                 timeline=timeline, condition=COND, coexistence=COEXISTENCE)
    } else {
        bd ~ dnBDS(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=RHO, present=PRESENT,
                 condition=COND, coexistence=COEXISTENCE)
    }
} else {
    if (SKYLINE) {
        bd ~ dnBDS(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=RHO, present=PRESENT,
                 timeline=timeline, condition=COND, origin=origin, coexistence=COEXISTENCE)
    } else {
        bd ~ dnBDS(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=RHO, present=PRESENT,
                 condition=COND, origin=origin, coexistence=COEXISTENCE)
    }
}

# the reporting model is its own node now, clamped to the observed record, and it names the
# rule rather than flagging it
if (COMPLETE) {
    rec ~ dnFossilRecord(ranges=bd, reporting="complete")
} else {
    rec ~ dnFossilRecord(ranges=bd, reporting="firstlast")
}
rec.clamp(taxa)

moves.append( mvMatrixElementScale(bd, lambda=0.01, weight=taxa.size()/10) )
moves.append( mvMatrixElementScale(bd, lambda=0.1,  weight=taxa.size()/10) )
moves.append( mvMatrixElementScale(bd, lambda=1,    weight=taxa.size()/10) )
moves.append( mvMatrixElementSlide(bd, delta=0.01, weight=taxa.size()/10) )
moves.append( mvMatrixElementSlide(bd, delta=0.1,  weight=taxa.size()/10) )
moves.append( mvMatrixElementSlide(bd, delta=1,    weight=taxa.size()/10) )

# lets the oldest birth change lineage, which a random walk mixes over poorly
moves.append( mvMatrixElementSwap(bd, col=4, weight=taxa.size()/5) )

# rho < 1 puts a point mass at the present on every taxon reported extinct, which the
# continuous element moves cannot reach
if (RHO < 1.0) {
    moves.append( mvExtinctionRJSwitch(bd, weight=taxa.size()/5) )
}

org  := bd.getOrigin()
# mnModel monitors every node in the model, so a per-taxon latent is dropped by not
# creating it. One record of a thousand ranges writes 63 MB of them, which a rates
# comparison never reads. org is a scalar and stays either way.
if (!exists("LATENTS")) LATENTS <- TRUE
if (LATENTS) {
    # Under complete lineage sampling a birth is the species' own origination, so there is no
    # divergence to offer and RANGE_START can only be origination here. The conditional is
    # degenerate at the birth time, so the draw is that time.
    bb   := bd.getOriginationTimes()
    dd   := bd.getExtinctionTimes()
    tau1 := bd.getFirstAppearances()
    tauK := bd.getLastAppearances()
}

mymodel = model(bd)
monitors = VectorMonitors()
if (LATENTS) {
    monitors.append( mnModel(filename=OUTDIR + "/rep_" + rep + ".log", printgen=PRINTGEN) )
} else {
    # mnModel writes every node in the model, and the range matrix alone is four columns a
    # taxon, so dropping the latents is not enough on a thousand ranges. Name the rates
    # instead. A run like this records no hyperparameter truths, so it has no ranks for them.
    monitors.append( mnFile(filename=OUTDIR + "/rep_" + rep + ".log", printgen=PRINTGEN,
                            lambda, mu, psi, org) )
}
monitors.append( mnScreen(printgen=100000) )
mymcmc = mcmc(mymodel, monitors, moves, moveschedule="single")
mymcmc.run(generations=GENS)
q()
