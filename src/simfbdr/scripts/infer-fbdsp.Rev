### Skyline FBD-range inference over dnFBDSP, the range process on a sampled budding tree, with the
### record on a dnFossilRecord node and, when the run asks for them, the characters on a
### dnPhyloCTMC node over the speciation counts that fnTreeAssembly puts on the same tree.
###
### Every prior hyperparameter arrives as a variable set by the per-rep aux file that simfbdr
### writes from the batch's config.yml, as for infer-fbdrp.Rev.
###
### Set before sourcing: rep, SKYLINE, REPORTING, COND, RHO, RANGE_START, GENS, PRINTGEN,
###   OCCURRENCES, BATCHDIR, OUTDIR, the GAMMA_ settings, AGE_MIN, AGE_MAX, ORIGIN_PRIOR, MAXFA,
###   ANAGENESIS, CHARS, and with CHARS: CHARFILE, NSTATES, EPS_A, EPS_B, CODING, EPSILON_A, EPSA_A, EPSA_B,
###   CHAR_INFER, and with CHAR_INFER mk: MKR_SHAPE, MKR_RATE; and as for mixture-prior.Rev

# TAXA is set when the run treats the occurrence ages some other way than as reported
if (!exists("TAXA")) TAXA <- BATCHDIR + "/" + OCCURRENCES + "/taxa_" + rep + ".tsv"
taxa <- readTaxonData(TAXA)

moves = VectorMoves()

# the rate prior and its guards live in one place, so the arms cannot drift
source(BINDIR + "/rates-prior.Rev")

# dnFBDSP needs an origin, so simfbdr refuses origin_prior none before this. AGE_MAX is above
# every occurrence, so starting there is always feasible.
if (ORIGIN_PRIOR == "exponential") {
    origin ~ dnExponential(1/MAXFA, offset=MAXFA)
} else {
    origin ~ dnUniform(AGE_MIN, AGE_MAX)
}
origin.setValue(AGE_MAX)
# Measured at four widths down to 0, this move accepts 0.31 to 0.37 on some replicates, under
# mvSlide's 0.44 target whatever delta is. Tuning then only divides, 0.833 an interval, and it stops
# at the end of burn-in, so the run inherits a delta too small to move the origin at all.
moves.append( mvSlide(origin, delta=1, weight=2, tune=false) )

# The anagenetic rate is constant in time and drawn from the speciation prior, as the batch drew
# it. Without anagenesis it is zero, which is pure budding.
if (ANAGENESIS) {
    lambda_a ~ dnGamma(GAMMA_L_SHAPE, gamma_rate_lambda)
    moves.append( mvScale(lambda_a, lambda=1, weight=2) )
} else {
    lambda_a <- 0.0
}

# A speciation is symmetric with chance beta, constant in time and drawn from the batch's prior. Without
# it, beta is zero, which is pure budding.
if (!exists("SYMMETRIC")) SYMMETRIC <- FALSE
if (SYMMETRIC) {
    beta ~ dnBeta(SYM_A, SYM_B)
    moves.append( mvBetaProbability(beta, weight=1) )
} else {
    beta <- 0.0
}

# every new species draws its own relative sampling rate from the batch's mixture, however it arose
if (!exists("PSI_MIX")) PSI_MIX <- FALSE
source(BINDIR + "/mixture-prior.Rev")

if (SKYLINE) {
    tr ~ dnFBDSP(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=RHO, present=PRESENT,
                 timeline=timeline, condition=COND, origin=origin, lambda_a=lambda_a, beta=beta,
                 psiMixtureRates=mix_rates, psiMixtureWeights=mix_w)
} else {
    tr ~ dnFBDSP(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=RHO, present=PRESENT,
                 condition=COND, origin=origin, lambda_a=lambda_a, beta=beta,
                 psiMixtureRates=mix_rates, psiMixtureWeights=mix_w)
}

rec ~ dnFossilRecord(ranges=tr, reporting=REPORTING)
rec.clamp(taxa)

# every age in the tree needs a move: the tips are extinction times, the internal nodes births. A sampled
# ancestor's tip moves its node, and a symmetric node collapsed there with it
moves.append( mvFossilTipTimeUniform(tr, origin=origin, weight=taxa.size()/5) )
if (taxa.size() > 1) {
    moves.append( mvFNPR(tr, weight=taxa.size()) )
    moves.append( mvNodeTimeSlideUniform(tr, weight=taxa.size()) )
    moves.append( mvRootTimeSlideUniform(tr, origin=origin, weight=2) )
    # which child continues its ancestor's species, or where beta > 0 neither, which sets beta's mixing too: a
    # latent move, at taxa.size() under symmetric speciation. It also flips each sampled ancestor's successor
    # between anagenesis and symmetric speciation
    moves.append( mvSpeciationMode(tr, weight=ifelse(SYMMETRIC, taxa.size(), taxa.size()/5)) )
    # an exact draw of the topology given the ranges, valid under pure budding only
    if (!ANAGENESIS && !SYMMETRIC) moves.append( mvBuddingTopologyRedraw(tr, weight=4) )
}
# a sampled species that ends at a symmetric speciation is a sampled ancestor at that node, which only this
# move reaches
if (SYMMETRIC && taxa.size() > 1) {
    moves.append( mvCollapseExpandBifurcation(tr, weight=taxa.size()/5) )
}
# sampled ancestors, wherever a range ends by anagenesis or a symmetric speciation with one sampled daughter
if (ANAGENESIS || SYMMETRIC) {
    moves.append( mvCollapseExpandFossilBranch(tr, origin, weight=taxa.size()/5) )
}
if (ANAGENESIS) {
    # regrafts a subtree at a new age or onto a fossil, which mixes the anagenetic events with the topology
    moves.append( mvWilsonBalding(tr, symmetric=SYMMETRIC, weight=taxa.size()) )
}
# the first and last appearances, which the tree does not carry
moves.append( mvStratigraphicRange(tr, weight=taxa.size()) )

# an exact Gibbs draw of each species' component
if (PSI_MIX) {
    moves.append( mvPsiMixtureAllocation(tr, weight=taxa.size()/5) )
}

# rho < 1 puts a point mass at the present on every taxon reported extinct
if (RHO < 1.0) {
    moves.append( mvExtinctionRJSwitch(tr, weight=taxa.size()/5) )
}
# under presence a taxon reported once over an interval may hold more than one occurrence
if (REPORTING == "presence") {
    moves.append( mvSingletonRJSwitch(tr, weight=taxa.size()/5) )
}

# Characters that change only at speciation, each character independently with probability
# epsilon, as the batch simulated them. The speciations on a branch are the latents: dnFBDSP gives
# the Poisson mean of the ones that left no sample, and fnTreeAssembly carries the drawn count as a
# branch length, so every character sees the one count rather than a count of its own.
if (!exists("CHAR_INFER")) CHAR_INFER <- "morphospeciation"
# or under Mk along each lineage in time, at a strict clock rate, the tips being the extinctions
if (CHARS && CHAR_INFER == "mk") {
    morpho <- readDiscreteCharacterData(CHARFILE)
    if (!exists("CODING")) CODING <- "all"
    char_rate ~ dnGamma(MKR_SHAPE, MKR_RATE)
    moves.append( mvScale(char_rate, lambda=1, weight=5) )
    morph ~ dnPhyloCTMC(tree=tr, Q=fnJC(NSTATES[1]), branchRates=char_rate, type="Standard", coding=CODING)
    morph.clamp(morpho)
} else if (CHARS) {
    morpho <- readDiscreteCharacterData(CHARFILE)
    # one Q carries every character, and branchRates cannot hold a length per character
    nst <- NSTATES[1]
    if (NSTATES.size() > 1) {
        for (j in 2:NSTATES.size()) {
            if (NSTATES[j] != nst) stop("morphospeciation over fnTreeAssembly needs the same number of states for every character.")
        }
    }
    if (!exists("RETENTION")) RETENTION <- false
    if (RETENTION) stop("retention was dnPhyloMorphospeciation's own correction and has no dnPhyloCTMC form.")

    epsilon ~ dnBeta(EPS_A, EPS_B)
    moves.append( mvSlide(epsilon, delta=0.05, weight=5) )
    # a matrix of variable characters only conditions each on varying; an rb before the option never sees it
    if (!exists("CODING")) CODING <- "all"
    # an anagenesis changes each character with its own probability epsilon_a
    if (!exists("EPSILON_A")) EPSILON_A <- false
    if (EPSILON_A) {
        epsilon_a ~ dnBeta(EPSA_A, EPSA_B)
        moves.append( mvSlide(epsilon_a, delta=0.05, weight=5) )
    }

    # One event changes a character with probability epsilon exactly when it carries this much Mk
    # branch length. Above (n-1)/n the change is a repulsion, which no branch length reaches, so
    # epsilon there is read as the complete randomization that (n-1)/n already is.
    cap <- (nst - 1) / nst
    ev  := abs(ifelse(epsilon < cap, cap * ln(abs(1 - epsilon/cap)), -1000.0))
    if (EPSILON_A) {
        eva := abs(ifelse(epsilon_a < cap, cap * ln(abs(1 - epsilon_a/cap)), -1000.0))
    } else {
        eva := ev
    }

    # By branch: the Poisson mean of the speciations that left no sample, and the observed event
    # that began the species. A mean of zero is no Poisson at all, so each carries a floor that
    # pins its count to zero without putting an impossible state in reach.
    hb := tr.getHiddenSpeciation(mode="budding")
    ob := tr.getObservedSpeciation(mode="budding")
    # a symmetric speciation changes each daughter with epsilon, as a budding changes its new species
    if (SYMMETRIC) {
        hs := tr.getHiddenSpeciation(mode="bifurcation")
        os := tr.getObservedSpeciation(mode="bifurcation")
    }
    if (ANAGENESIS) {
        ha := tr.getHiddenSpeciation(mode="anagenesis")
        oa := tr.getObservedSpeciation(mode="anagenesis")
    }
    for (i in 1:hb.size()) {
        kb[i] ~ dnPoisson(hb[i] + 1E-10)
        moves.append( mvRandomNaturalWalk(kb[i], weight=1) )
        if (SYMMETRIC) {
            ks[i] ~ dnPoisson(hs[i] + 1E-10)
            moves.append( mvRandomNaturalWalk(ks[i], weight=1) )
            cl[i] := kb[i] + ob[i] + ks[i] + os[i]
        } else {
            cl[i] := kb[i] + ob[i]
        }
        if (ANAGENESIS) {
            ka[i] ~ dnPoisson(ha[i] + 1E-10)
            moves.append( mvRandomNaturalWalk(ka[i], weight=1) )
            brl[i] := cl[i] * ev + (ka[i] + oa[i]) * eva
        } else {
            brl[i] := cl[i] * ev
        }
    }
    # the assembly leaves tr's own ages alone, so the characters and the record read one tree
    chartree := fnTreeAssembly(tr, brl)
    morph ~ dnPhyloCTMC(tree=chartree, Q=fnJC(nst), type="Standard", coding=CODING)
    morph.clamp(morpho)
}

org  := tr.getOrigin()
# the anagenetic events; bb cannot count them, since it draws each origination along the stem
if (ANAGENESIS) nsa := tr.numSampledAncestors()
# the symmetric speciations the tree shows, and the expected number it hides, for their mixing
if (SYMMETRIC) {
    obs_bif := sum(tr.getObservedSpeciation(mode="bifurcation"))
    hid_bif := sum(tr.getHiddenSpeciation(mode="bifurcation"))
}
# as for infer-fbdrp.Rev, a per-taxon latent is dropped by not creating it
if (!exists("LATENTS")) LATENTS <- TRUE
if (LATENTS) {
    bb   := tr.getOriginationTimes()
    dd   := tr.getExtinctionTimes()
    tau1 := tr.getFirstAppearances()
    tauK := tr.getLastAppearances()
    # under presence, 1 where a taxon's first and last appearances are one age: whether its one
    # reported occurrence in a bin was its only one there, which the record does not say
    if (REPORTING == "presence") single := tr.getSingletonStatus()
    # each taxon's psi mixture component, numbered from 1
    if (PSI_MIX) comp := tr.getPsiMixtureComponents()
}

mymodel = model(tr)
monitors = VectorMonitors()
if (!exists("EPSILON_A")) EPSILON_A <- false
if (LATENTS) {
    # the per-branch counts and the vectors they come from are nuisances with no truth to rank, and
    # there are seven of them per branch
    monitors.append( mnModel(filename=OUTDIR + "/rep_" + rep + ".log", printgen=PRINTGEN,
                             exclude=["kb", "ka", "ks", "hb", "ha", "hs", "ob", "oa", "os", "cl", "brl", "ev", "eva"]) )
} else if (CHARS && CHAR_INFER == "mk" && ANAGENESIS) {
    monitors.append( mnFile(filename=OUTDIR + "/rep_" + rep + ".log", printgen=PRINTGEN,
                            lambda, mu, psi, org, char_rate, lambda_a, nsa) )
} else if (CHARS && CHAR_INFER == "mk") {
    monitors.append( mnFile(filename=OUTDIR + "/rep_" + rep + ".log", printgen=PRINTGEN,
                            lambda, mu, psi, org, char_rate) )
} else if (CHARS && ANAGENESIS && EPSILON_A) {
    monitors.append( mnFile(filename=OUTDIR + "/rep_" + rep + ".log", printgen=PRINTGEN,
                            lambda, mu, psi, org, epsilon, epsilon_a, lambda_a, nsa) )
} else if (CHARS && ANAGENESIS) {
    monitors.append( mnFile(filename=OUTDIR + "/rep_" + rep + ".log", printgen=PRINTGEN,
                            lambda, mu, psi, org, epsilon, lambda_a, nsa) )
} else if (CHARS) {
    monitors.append( mnFile(filename=OUTDIR + "/rep_" + rep + ".log", printgen=PRINTGEN,
                            lambda, mu, psi, org, epsilon) )
} else if (ANAGENESIS) {
    monitors.append( mnFile(filename=OUTDIR + "/rep_" + rep + ".log", printgen=PRINTGEN,
                            lambda, mu, psi, org, lambda_a, nsa) )
} else {
    monitors.append( mnFile(filename=OUTDIR + "/rep_" + rep + ".log", printgen=PRINTGEN,
                            lambda, mu, psi, org) )
}
monitors.append( mnScreen(printgen=100000) )
mymcmc = mcmc(mymodel, monitors, moves, moveschedule="single")
# every move is tuned over a burn-in the log does not record
mymcmc.burnin(generations=GENS/10, tuningInterval=1000)
mymcmc.run(generations=GENS)
q()
